{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_r23.py",
  "cleanUrls": true,
  "functions": {
    "api/reveals.js": {
      "maxDuration": 10
    },
    "api/preorders.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "img-src 'self' data: https:"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/2026-review.html",
      "destination": "/encyclopedia.html",
      "permanent": false
    },
    {
      "source": "/agents.html",
      "destination": "/api.html",
      "permanent": false
    },
    {
      "source": "/archive-tour.html",
      "destination": "/index.html",
      "permanent": false
    },
