{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figure",
  "type": "object",
  "required": [
    "id",
    "name",
    "waveId",
    "waveSeries",
    "year",
    "manufacturer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id: <waveId>::<figureName>"
    },
    "name": {
      "type": "string"
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "exclusive": {
      "type": [
        "string",
        "null"
      ]
    },
    "bafPiece": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "waveId": {
      "type": "string"
    },
    "waveSeries": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "manufacturer": {
      "type": "string",
      "enum": [
        "Toy Biz",
        "Hasbro"
      ]
    },
    "waveBaf": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "mcu",
        "animated",
        "videogame",
        null
      ],
      "description": "Story source, classified only where the wave name explicitly names a screen/game source; null = unclassified (never guessed)"
    }
  }
}
