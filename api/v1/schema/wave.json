{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wave",
  "type": "object",
  "required": [
    "id",
    "year",
    "manufacturer",
    "series",
    "figureCount"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable kebab-case wave id"
    },
    "year": {
      "type": "integer"
    },
    "manufacturer": {
      "type": "string",
      "enum": [
        "Toy Biz",
        "Hasbro"
      ]
    },
    "series": {
      "type": "string"
    },
    "baf": {
      "type": [
        "string",
        "null"
      ]
    },
    "figureCount": {
      "type": "integer"
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "mcu",
        "animated",
        "videogame",
        null
      ],
      "description": "Story source, classified only where the wave name explicitly names a screen/game source; null = unclassified (never guessed)"
    }
  }
}
